# NextAuth
NEXTAUTH_URL=https://huntscoutpro.com
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Analytics (see ANALYTICS.md). Clarity defaults to project z6liofa1yc; "off" disables it.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=z6liofa1yc
# Google Ads tag + purchase conversion and Meta Pixel load only when set.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=your-conversion-label
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345
