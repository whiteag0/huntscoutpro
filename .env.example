# Every environment variable the app reads. Copy to .env.local for local work and
# fill in only what you need; Vercel holds the production values. Never commit values.

# --- Sign-in (next-auth) ---
# Secret that signs sessions, reminder unsubscribe links and free-reminder links (openssl rand -hex 32).
AUTH_SECRET=
# Older name for AUTH_SECRET; read as a fallback.
NEXTAUTH_SECRET=
# Public site origin, e.g. https://www.huntscoutpro.com. Used for checkout return URLs and legacy purchase matching.
NEXTAUTH_URL=
# Same as NEXTAUTH_URL under its newer name; either works.
AUTH_URL=
# Locally only: trust the Host header so sign-in works on localhost (Vercel sets this itself).
AUTH_TRUST_HOST=
# Google OAuth client for "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin email: always Pro, sees admin tools. Defaults to the owner's address when unset.
SUPER_ADMIN_EMAIL=
# Enables the admin password sign-in when set together with SUPER_ADMIN_EMAIL (no default; leave unset in production).
SUPER_ADMIN_PASSWORD=
# Manual Pro grants, comma-separated: a@x.com or a@x.com:YYYY-MM-DD (access end). Customer emails: keep out of the repo.
PRO_EMAIL_OVERRIDES=

# --- Payments (Stripe) ---
# Server key; without it checkout, membership checks and the member jobs are off.
STRIPE_SECRET_KEY=
# Signing secret of the /api/webhook endpoint (checkout completed, refunds, disputes).
STRIPE_WEBHOOK_SECRET=
# "true" pauses checkout with a "temporarily unavailable" message.
CHECKOUT_PAUSED=

# --- Email (Resend) ---
# Resend API key. Unset = no email is sent (local and preview builds log instead).
RESEND_API_KEY=
# From line on every email. Default: "Adam White, HuntScout Pro <adam@huntscoutpro.com>".
EMAIL_FROM=
# Reply-To on member emails when inbound replies aren't set up. Default: adam@huntscoutpro.com.
EMAIL_REPLY_TO=
# Comma-separated addresses BCC'd on onboarding emails, scouting reports and form-answer notifications (not digests, nudges or owner alerts).
ONBOARDING_BCC=
# Where "New HuntScout Pro purchase" alerts and the daily onboarding check go. Default: adam@huntscoutpro.com.
OWNER_ALERTS_TO=
# Where a member's /welcome answers are sent. Default: adam@huntscoutpro.com.
PREFERENCES_NOTIFY_TO=
# Where "Request this state" submissions are sent. Default: adam@huntscoutpro.com.
STATE_REQUEST_TO=
# Local QA only: point Resend calls at a mock server instead of https://api.resend.com.
RESEND_API_BASE=

# --- Daily job (vercel.json cron: deadline reminders, onboarding check, profile nudges) ---
# Vercel sends "Authorization: Bearer $CRON_SECRET"; the job refuses to run without it.
CRON_SECRET=

# --- Storage (Vercel Blob: planner sync, free reminder subscribers, reply threads) ---
# Blob store id; set by Vercel when the store is connected (it authenticates with OIDC, no token).
BLOB_STORE_ID=
# Local QA only: folder used instead of Blob outside Vercel (defaults to a temp folder in development).
BLOB_LOCAL_DIR=
# Local QA only: folder for planner documents instead of Blob.
PLANNER_LOCAL_DIR=

# --- Customer reply drafts (see INBOUND_EMAIL.md). Off until both of the first two are set. ---
# Address customers reply to; Resend inbound receives it.
EMAIL_INBOUND_ADDRESS=
# Signing secret of the Resend inbound webhook (whsec_...).
RESEND_INBOUND_WEBHOOK_SECRET=
# Who approves reply drafts. Default: adam@huntscoutpro.com.
ADMIN_EMAIL=
# AI Gateway model for drafts, provider/model. Default: anthropic/claude-sonnet-5.5.
REPLY_MODEL=
# Local only: AI Gateway key (Vercel uses OIDC).
AI_GATEWAY_API_KEY=
# Local QA only: "1" returns a canned draft instead of calling a model (ignored in production).
REPLY_MODEL_MOCK=

# --- Analytics (see ANALYTICS.md) ---
# Microsoft Clarity project; defaults to the site's project, "off" disables it.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Google Ads tag id and purchase conversion label; the tag loads only when set.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Meta Pixel id; loads only when set.
NEXT_PUBLIC_META_PIXEL_ID=

# Set by the platform, never by hand: NODE_ENV, VERCEL (on Vercel), GITHUB_OUTPUT (data-check CI scripts).
